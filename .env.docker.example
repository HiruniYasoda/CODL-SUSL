# CODL-SUSL Docker Environment Configuration Template
# Copy this file to .env and fill in strong, unique secrets for your deployment.

# Application Environment
APP_ENV=production
APP_DEBUG=false
FRONTEND_PORT=80

# Database Configuration
DB_DATABASE=codl_susl
DB_USERNAME=codluser
# Set strong, secure passwords before running docker-compose up
DB_PASSWORD=change_this_to_a_secure_database_password
DB_ROOT_PASSWORD=change_this_to_a_secure_root_password
